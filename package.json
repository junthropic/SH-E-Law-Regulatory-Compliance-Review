{
  "name": "sh-e-law-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && node --watch build/server/index.js",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "sync": "node --env-file-if-exists=.env build/scripts/sync.js",
    "backup": "node build/scripts/backup.js",
    "publish:check": "node build/scripts/public-check.js",
    "approve": "node build/scripts/approve.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "adm-zip": "0.6.1",
    "diff": "9.0.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "kordoc": "4.18.2",
    "korean-law-mcp": "4.15.5",
    "lucide-react": "1.49.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
